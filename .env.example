# Safe local defaults. Copy to .env for local development; never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WORKER_POLL_INTERVAL_SECONDS=1.0

# Local service URLs only; runtime migrations run only when an explicit URL is configured.
DATABASE_URL=postgresql://memeradar:memeradar@postgres:5432/memeradar
REDIS_URL=redis://redis:6379/0
REQUIRE_DATABASE_FOR_READINESS=false
REQUIRE_REDIS_FOR_READINESS=false

# Optional Helius read-only provider doctor. Never commit real credentials.
HELIUS_RPC_URL=
HELIUS_API_KEY=

# Optional provider-independent E8.4 stream/backfill endpoints. Presence is
# never a provider PASS; use `make stream-integrity-doctor` for a key-safe
# local contract check and external acceptance remains explicit.
MEMERADAR_SOLANA_STREAM_URL=
MEMERADAR_SOLANA_BACKFILL_URL=

# Optional Birdeye read-only market provider doctor. Never commit real credentials.
BIRDEYE_API_URL=
BIRDEYE_API_KEY=

# Optional quote source for paper replay/external acceptance checks. The paper
# engine itself consumes normalized QuoteSnapshot values and never signs or
# submits transactions. Never commit real credentials.
MEMERADAR_PAPER_QUOTE_URL=
MEMERADAR_PAPER_QUOTE_API_KEY=

# Optional RugCheck read-only risk provider doctor. The summary/ping routes are public;
# configure a JWT only when the provider requires it. Never commit real credentials.
RUGCHECK_API_URL=
RUGCHECK_API_KEY=

# Optional compliant social/X read provider doctor. Never commit real credentials.
SOCIAL_API_URL=
SOCIAL_API_KEY=

# Optional external wallet intelligence; no live adapter is enabled by default.
EXTERNAL_WALLET_API_URL=
EXTERNAL_WALLET_API_KEY=

# Optional structured narrative provider doctor. Never commit real credentials.
NARRATIVE_API_URL=
NARRATIVE_API_KEY=
NARRATIVE_MODEL=

# Optional Telegram alert destination. Never commit a real bot token.
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MAX_MESSAGES_PER_WINDOW=20
ALERT_RATE_LIMIT_WINDOW_SECONDS=60

# Optional operator bearer token for the analysis-only manual mint endpoint.
# Role-scoped bearer tokens for the authenticated control/read surface. Leave
# blank unless this local process is intentionally configured as an operator deployment.
VIEWER_API_TOKEN=
OPERATOR_API_TOKEN=
ADMIN_API_TOKEN=
EXECUTION_API_TOKEN=

# Optional server-only token used by the web read gateway. Never prefix this
# variable with NEXT_PUBLIC_ and never expose its value to browser code.
MEMERADAR_VIEWER_API_TOKEN=

# Protected operating modes. Do not change these to enable live-money execution.
ANALYSIS_ONLY=true
PAPER_TRADING=true
MANUAL_EXECUTION=false
AUTO_EXECUTION=false
