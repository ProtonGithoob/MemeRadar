# Safe local defaults. Copy to .env for local development; never commit .env.

# ============================================================
# CORE
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WORKER_POLL_INTERVAL_SECONDS=1.0
READINESS_TIMEOUT_SECONDS=0.25
EARLY_SCORE_HANDOFF_SECONDS=300
ENABLED_CHAINS=solana,bnb,robinhood

DATABASE_URL=postgresql://memeradar:memeradar@postgres:5432/memeradar
REDIS_URL=redis://redis:6379/0
REQUIRE_DATABASE_FOR_READINESS=false
REQUIRE_REDIS_FOR_READINESS=false

# Production deployments must set APP_ENV=production, use secret DB/Redis
# URLs, set both readiness requirements to true, and provide unique strong
# VIEWER/OPERATOR/ADMIN_API_TOKEN values. The web gateway uses the server-only
# URL/token variables below; never move them to NEXT_PUBLIC_*.
MEMERADAR_API_BASE_URL=http://api:8000


# ============================================================
# SOLANA — FREE FIRST
# ============================================================

# Official public RPC; rate-limited and non-guaranteed. Use Helius only as an
# optional enhanced/read-only provider when a free-tier key is supplied.
SOLANA_RPC_URL=https://api.mainnet.solana.com
HELIUS_RPC_URL=
HELIUS_API_KEY=

# Provider-independent stream/backfill seams. A configured URL is not proof of
# a verified stream until the stream-integrity/live-shadow doctor passes.
MEMERADAR_SOLANA_STREAM_URL=
MEMERADAR_SOLANA_BACKFILL_URL=
# Compatibility aliases retained by Settings:
SOLANA_STREAM_URL=
HELIUS_WEBSOCKET_URL=
SOLANA_RPC_BACKFILL_URL=


# ============================================================
# EVM CHAINS — READ ONLY
# ============================================================

# BNB is optional until a public/provider RPC is configured. Robinhood Chain
# uses its public RPC by default; Settings verifies its chain id at runtime.
BNB_RPC_URL=
BNB_RPC_FALLBACK_URL=
BNB_CHAIN_ID=56
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_FALLBACK_URL=
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_SEQUENCER_FEED_URL=wss://feed.mainnet.chain.robinhood.com
ROBINHOOD_BLOCKSCOUT_API_URL=

# Optional MadeOnSol Robinhood Chain evidence; disabled and server-side only by default.
MADEONSOL_ENABLED=false
MADEONSOL_API_KEY=
MADEONSOL_BASE_URL=https://madeonsol.com/api/v1

# Optional GMGN server-side read-only SOL/BSC intelligence. Disabled and
# unweighted by default; this never enables trading, signing or wallet custody.
GMGN_ENABLED=false
GMGN_API_KEY=
GMGN_BASE_URL=https://openapi.gmgn.ai


# ============================================================
# MARKET DATA — FREE FIRST
# ============================================================

MARKET_DATA_PROVIDER=dexscreener
DEXSCREENER_API_URL=https://api.dexscreener.com
DEXSCREENER_API_KEY=
# Compatibility alias for older deployments:
DEXSCREENER_API_BASE_URL=

# Optional Birdeye market/discovery enhancement or fallback.
BIRDEYE_API_URL=
BIRDEYE_API_KEY=


# ============================================================
# PAPER QUOTES
# ============================================================

PAPER_QUOTE_PROVIDER=dexscreener

# Legacy/custom normalized quote seam. These values are retained for
# compatibility; a URL/key alone never causes raw HTTP from paper logic.
MEMERADAR_PAPER_QUOTE_URL=
MEMERADAR_PAPER_QUOTE_API_KEY=
# Compatibility aliases:
JUPITER_QUOTE_URL=
JUPITER_API_BASE_URL=
JUPITER_API_KEY=


# ============================================================
# RISK
# ============================================================

# Local deterministic risk checks remain authoritative. RugCheck public
# summary/ping routes may work without a key; configure a key only when a
# specific authenticated route requires it.
RUGCHECK_API_URL=
RUGCHECK_API_KEY=


# ============================================================
# WALLET INTELLIGENCE
# ============================================================

WALLET_INTELLIGENCE_PROVIDER=local
# Optional enrichment only; local wallet tracking/scoring/graph/flow analysis
# continues when this provider is absent.
EXTERNAL_WALLET_API_URL=
EXTERNAL_WALLET_API_KEY=
EXTERNAL_WALLET_STREAM_URL=


# ============================================================
# SOCIAL
# ============================================================

# Declared websites/social links from DexScreener are free metadata only.
SOCIAL_METADATA_PROVIDER=dexscreener
# Optional compliant social search/analytics provider. No X/Twitter scraping.
SOCIAL_API_URL=
SOCIAL_API_KEY=

# Optional public identity metadata; never place credentials in these values.
WEBSITE_URL=
WEBSITE_NAME=


# ============================================================
# NARRATIVE — LOCAL / OPTIONAL AI
# ============================================================

NARRATIVE_PROVIDER=ollama
NARRATIVE_API_URL=http://host.docker.internal:11434
NARRATIVE_API_KEY=
# Model selection is intentionally empty: Ollama remains optional until a
# locally installed model is explicitly selected.
NARRATIVE_MODEL=
# Set NARRATIVE_PROVIDER=disabled for a zero-dependency narrative path.


# ============================================================
# TELEGRAM
# ============================================================

TELEGRAM_API_URL=https://api.telegram.org
ALERT_MAX_MESSAGES_PER_WINDOW=20
ALERT_RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=


# ============================================================
# AUTH
# ============================================================

VIEWER_API_TOKEN=
OPERATOR_API_TOKEN=
ADMIN_API_TOKEN=
EXECUTION_API_TOKEN=
# Server-only web read gateway token. Never use NEXT_PUBLIC_* for secrets.
MEMERADAR_VIEWER_API_TOKEN=
# Server-only web settings mutation token; never expose to browser code.
MEMERADAR_ADMIN_API_TOKEN=


# ============================================================
# PROTECTED MODES — DO NOT RELAX
# ============================================================

ANALYSIS_ONLY=true
PAPER_TRADING=true
MANUAL_EXECUTION=false
AUTO_EXECUTION=false

X_PROVIDER_ENABLED=false

X_PROVIDER_API_KEY=
X_PROVIDER_BEARER_TOKEN=
